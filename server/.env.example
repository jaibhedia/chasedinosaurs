# ========================================
# SOCKET.IO SERVER — environment variables
# ========================================
# Local dev: copy to `.env` (optional — sensible defaults exist).
# Production: set these in the host's dashboard. PORT is injected by Render
# automatically — do not set it there.

# --- Core ---
NODE_ENV=development
SOCKET_PORT=3001

# Comma-separated allowed browser origins. Unset = allow any origin (dev only).
# Production example: https://chasedinosaurs.fun,capacitor://localhost,https://localhost
CORS_ORIGIN=http://localhost:5173


# ============================================================
# AI PROVIDER — bot personalities and taunts. Server-side ONLY.
# Never prefix with VITE_. A funded key in the browser bundle is
# a key anyone can spend.
# ============================================================
# Any OpenAI-compatible endpoint. Set these and the bots talk; leave them unset and
# the bots still play on local tactics, just silently.
#
#   OpenAI      : leave AI_BASE_URL unset
#   anything else: point AI_BASE_URL at its /v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional label for /health. Derived from the endpoint host if unset.
# AI_PROVIDER_NAME=

# Older deployments used OG_ROUTER_BASE_URL / OG_ROUTER_API_KEY / OG_MODEL. Those are
# still read as a fallback when the AI_* vars above are unset.


# ============================================================
# ALL-TIME LEADERBOARD — where it's saved
# ============================================================
# Upstash Redis (free tier, upstash.com) survives restarts, deploys and idle sleeps.
# Leave both unset to use a local file instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Folder for leaderboard.json when Upstash isn't set (default: ./data).
# DATA_DIR=


# ============================================================
# ADMIN SPECTATOR MODE (/admin)
# ============================================================
# Comma-separated admin emails. Unset: nobody can spectate.
ADMIN_EMAILS=
# SECRET. Asked for alongside the email; unset, an allowlisted email alone gets in.
ADMIN_PASSCODE=
