# ========================================
# Web app (Vite) — build-time env vars
# ========================================
# Vite inlines VITE_* vars at BUILD time. Local dev: copy to `.env.local`.

# Multiplayer server. Optional: on localhost the app already uses http://localhost:3001,
# and a production build without this falls back to the production server (see
# src/config.ts). Any build can be pointed elsewhere at runtime with ?server=<url>.
# VITE_SOCKET_URL=https://your-server.example.com

# Top-left RTT/FPS diagnostic overlay (true/false). Default false.
# Runtime override without a rebuild: append ?netstats=1 (or ?netstats=0) to the URL.
VITE_SHOW_NETSTATS=false
